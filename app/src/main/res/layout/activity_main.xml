<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/mainColor"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:id="@+id/head_title"
        android:layout_height="wrap_content"
        android:layout_width="match_parent">
    <ImageView
        android:layout_marginStart="15dp"
        android:id="@+id/logoImage"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/puzzle"

         />

    <TextView
        android:gravity="center"
        android:id="@+id/logoName"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/logoImage"
        android:layout_height="60dp"
        android:layout_width="wrap_content"
        tools:ignore="MissingConstraints"
        android:text="QuizLand"
        android:textColor="@color/white"

        />


    <SearchView
        android:layout_weight="1"
        android:id="@+id/Search"
        android:layout_width="150dp"
        android:layout_height="35dp"
        android:layout_marginStart="15dp"
        android:background="@drawable/search_view_bg"
        app:layout_constraintStart_toEndOf="@+id/logoName"
        tools:ignore="MissingConstraints"
        />

        <ImageView
            android:layout_marginStart="15dp"
            android:clickable="true"
            android:src="@drawable/icons_bg"
            android:id="@+id/imageAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="15dp"
            />
    </LinearLayout>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:elevation="10dp"
            android:layout_marginTop="25dp"
            android:id="@+id/go_view"
            android:minWidth="300dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/title_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/head_title">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/go_view"
                android:layout_marginTop="25dp"
                android:gravity="center_horizontal"
                android:text="Проверь\nсвои знания\nсегодня!"
                android:textColor="@color/white"
                android:textSize="25dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/go_view"
                app:layout_constraintStart_toStartOf="@+id/go_view"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                app:layout_constraintEnd_toEndOf="@+id/go_view"
                app:layout_constraintStart_toStartOf="@+id/go_view"
                android:lineSpacingMultiplier="1.3"
                android:text="Ежедневные викторины,\nсоревнования с друьями и\n уникальные категории.\nНайди свой челендж!"
                android:textColor="@color/grey"
                app:layout_constraintTop_toBottomOf="@+id/title"
                tools:ignore="MissingConstraints" />

            <Button
                android:id="@+id/startGo"
                android:backgroundTint="@color/buttonColor"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Начать тест"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="25dp"
                app:layout_constraintEnd_toEndOf="@+id/go_view"
                app:layout_constraintStart_toStartOf="@+id/go_view"
                app:layout_constraintTop_toBottomOf="@id/description"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/go_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/Top_Text"
            android:layout_width="match_parent"
            android:layout_height="35dp">
            <ImageView
                android:layout_marginStart="25dp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/topimage"
                />
            <TextView
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:text="В топе"
                />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="15dp"
            android:id="@+id/quizRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="15dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toBottomOf="@+id/Top_Text" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>