<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="190dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/quiz_bg"
    android:elevation="8dp"
    android:padding="10dp">

    <ImageView
        android:id="@+id/quizPreview"
        android:layout_width="0dp"
        android:layout_height="95dp"
        android:scaleType="centerCrop"
        android:background="@drawable/title_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/quizTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:text="Название квиза"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/quizPreview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/quizInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0 посещений"
        android:textColor="@color/grey"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/quizTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/startQuizButton"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/start_button"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>